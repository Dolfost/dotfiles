[Unit]
Description=Pi-hole (network-wide DNS ad blocker)
After=network-online.target
Wants=network-online.target
# Web+DNS are published on the Tailscale IP (100.91.220.75), which only appears
# once tailscaled is up — later than this user service starts at boot. Binding it
# too early fails ("Cannot assign requested address") and kills the container.
# ExecStartPre (below) waits for that IP; disabling the start-rate-limit keeps
# systemd retrying instead of giving up with "start-limit-hit".
StartLimitIntervalSec=0

[Container]
ContainerName=pihole
Image=docker.io/pihole/pihole:latest
AutoUpdate=registry

# DNS stays on localhost and is exposed on the tailnet via the Tailscale service
# VIP (tailscaled binds svc:pihole's :53 as root — no privileged host bind, no
# clash with resolved/dnsmasq on the host's own :53):
#   DNS -> 127.0.0.1:5335 (tcp+udp), fronted by the svc:pihole tcp:53 endpoint
PublishPort=127.0.0.1:5335:53/tcp
PublishPort=127.0.0.1:5335:53/udp
# Also on the LAN IP at the real :53 so the router can hand $PIHOLE_LAN_IP out
# as the DHCP DNS server. Rootless can only bind :53 where
# net.ipv4.ip_unprivileged_port_start<=53 — NixOS sets that in
# nix/hosts/aorus/services.nix, Arch in /etc/sysctl.d/99-rootless-dns.conf.
# Nothing else holds this IP:53.
PublishPort=${PIHOLE_LAN_IP}:53:53/tcp
PublishPort=${PIHOLE_LAN_IP}:53:53/udp
# On this node's Tailscale IP too, so tailnet devices can use it as their DNS
# via a Tailscale global nameserver (set to $PIHOLE_TS_IP). NOT via the
# svc:pihole VIP: Tailscale services forward TCP only, but DNS is UDP — so a
# service VIP can't serve DNS. Point the global nameserver at this node IP.
PublishPort=${PIHOLE_TS_IP}:53:53/tcp
PublishPort=${PIHOLE_TS_IP}:53:53/udp
# Web UI on loopback + this node's Tailscale IP only (NOT the LAN interface): it
# answers at http://daorus.faun-castor.ts.net:8080/admin over the tailnet and at
# http://127.0.0.1:8080 locally — password-protected, and intentionally NOT on
# the svc:pihole service URL.
PublishPort=127.0.0.1:8080:80/tcp
PublishPort=${PIHOLE_TS_IP}:8080:80/tcp

# Every host-specific value is an env var so nothing host-specific is baked into
# this (git-tracked) quadlet.
#
# On NixOS these are generated from nix/hosts/aorus/services.nix — do not edit
# them by hand there. On Arch they live in an untracked drop-in at
# 	systemd/user/pihole.service.d/override.conf
# in this repo (~/.config/systemd is a symlink to systemd/, and its .gitignore
# keeps the drop-in out of git). Edit it directly, or via
# 	systemctl --user edit pihole.service
# 	[Service]
# 	Environment=PIHOLE_DIR=/storage/2.5_inch/pihole
# 	Environment=PIHOLE_TS_IP=100.91.220.75
# 	Environment=PIHOLE_LAN_IP=192.168.0.70

# All Pi-hole state (pihole.toml, gravity/FTL DBs, dnsmasq config) lives under
# $PIHOLE_DIR — move that dir + this quadlet and the instance moves with it.
Volume=${PIHOLE_DIR}:/etc/pihole:Z

Environment=TZ=Europe/Kyiv
# Queries arrive via podman's port-forwarder, so their source IP is outside
# Pi-hole's own subnet; "all" makes FTL answer them instead of refusing.
Environment=FTLCONF_dns_listeningMode=all
Environment=FTLCONF_dns_upstreams=1.1.1.1;9.9.9.9
# Admin password is NOT kept here — it lives as a hash in pihole.toml (in the
# data dir), set once with:  podman exec -it pihole pihole setpassword

[Service]
# Block startup until the Tailscale IP exists (up to 120s), so podman never
# tries to publish a port on an address that isn't there yet.
#
# /bin/sh is the only absolute path here: it is the one interpreter both
# distros agree on. NixOS has no /usr/bin at all, so timeout/ip/grep are looked
# up on PATH instead. systemd expands ${PIHOLE_TS_IP} before sh sees the string
# — which is also why this loop uses no shell variables of its own.
ExecStartPre=/bin/sh -c 'timeout 120 sh -c "until ip -4 addr show tailscale0 2>/dev/null | grep -q ${PIHOLE_TS_IP}/; do sleep 2; done"'
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
