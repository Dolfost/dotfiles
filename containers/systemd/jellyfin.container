[Unit]
Description=Jellyfin Media Server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=jellyfin
Image=docker.io/jellyfin/jellyfin:latest
AutoUpdate=registry

PublishPort=8096:8096
# Optional: LAN auto-discovery for the Jellyfin apps + DLNA. Uncomment if wanted.
#PublishPort=7359:7359/udp
#PublishPort=1900:1900/udp

# Every host path is an env var so nothing host-specific is baked into this
# (git-tracked) quadlet.
#
# On NixOS these are generated from nix/hosts/aorus/services.nix — do not edit
# them by hand there. On Arch they live in an untracked drop-in at
# 	systemd/user/jellyfin.service.d/override.conf
# in this repo (~/.config/systemd is a symlink to systemd/, and its .gitignore
# keeps the drop-in out of git). Edit it directly, or via
# 	systemctl --user edit jellyfin.service
# The Arch values are:
# 	[Service]
# 	Environment=JELLYFIN_DIR=/storage/2.5_inch/media/jellyfin
# 	Environment=JELLYFIN_MOVIES=/storage/2.5_inch/media/movies
# 	Environment=JELLYFIN_SHOWS=/storage/2.5_inch/media/shows
# 	Environment=JELLYFIN_SHOWS_HDD=/storage/3.5_inch/media/shows
# 	Environment=JELLYFIN_MUSIC=/storage/2.5_inch/media/music
# 	Environment=JELLYFIN_BOOKS=/storage/2.5_inch/media/books

# All Jellyfin state (settings, users, watch history, metadata, plugins) lives
# under $JELLYFIN_DIR — move that dir + this quadlet and the instance moves with
# it. The image keeps config in /config/config and data in /config (see its
# JELLYFIN_CONFIG_DIR / JELLYFIN_DATA_DIR env), so the whole thing is one dir.
Volume=${JELLYFIN_DIR}:/config:Z
Volume=${JELLYFIN_DIR}/cache:/cache:Z

# Each library is mounted read-only at a FIXED, host-neutral container path.
# Only the host side comes from an env var. Arch mounts the disks at
# /storage/2.5_inch and /storage/3.5_inch, NixOS at /storage/2.5 and
# /storage/3.5 — but the container sees /media/* either way, so the paths
# Jellyfin records in its DB mean the same thing on both.
#
# That matters here specifically because BOTH systems share ONE database:
# ${JELLYFIN_DIR} is the same directory on the same disk, reached under two
# different mountpoints. Whichever OS scans last wins, so both must agree on
# the container-side paths or the other one gets a library it cannot read.
#
# Do NOT write ${VAR}:${VAR} here. That re-couples the container's view to the
# host mountpoint, and renaming a mountpoint then breaks playback silently —
# the library still lists, because that comes from the DB, but every file
# lookup misses.
#
# shows2 is the overflow library on the spinning disk. The name is deliberately
# neutral: if those files ever move to another disk, only the env var changes.
Volume=${JELLYFIN_MOVIES}:/media/movies:ro
Volume=${JELLYFIN_SHOWS}:/media/shows:ro
Volume=${JELLYFIN_SHOWS_HDD}:/media/shows2:ro
Volume=${JELLYFIN_MUSIC}:/media/music:ro
Volume=${JELLYFIN_BOOKS}:/media/books:ro

# GPU for hardware transcoding (renderD128 is world-accessible, 0666, so the
# rootless container can use it without a group). Remove this on a host with no
# GPU, otherwise the unit fails to start.
AddDevice=/dev/dri/renderD128

Environment=TZ=Europe/Kyiv

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
