[Unit]
Description=Navidrome Music Server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=navidrome
Image=ghcr.io/navidrome/navidrome:latest
AutoUpdate=registry

PublishPort=4533:4533

# Every host path is an env var so nothing host-specific is baked into this
# (git-tracked) quadlet.
#
# On NixOS these are generated from nix/hosts/aorus/services.nix — do not edit
# them by hand there. On Arch they live in an untracked drop-in at
# 	systemd/user/navidrome.service.d/override.conf
# in this repo (~/.config/systemd is a symlink to systemd/, and its .gitignore
# keeps the drop-in out of git). Edit it directly, or via
# 	systemctl --user edit navidrome.service

# All Navidrome state lives under $NAVIDROME_DIR — the DB (users, play counts,
# ratings, playlists), navidrome.toml (app settings + your Last.fm keys), cache
# and artwork. Move that dir + this quadlet and the instance moves with it. The
# image reads its config from /data/navidrome.toml by default (ND_CONFIGFILE).
Volume=${NAVIDROME_DIR}:/data:Z

# Each library is mounted read-only at a FIXED, host-neutral container path, so
# the same DB works from either OS (Arch mounts the disk at /storage/2.5_inch,
# NixOS at /storage/2.5 — and $NAVIDROME_DIR is the same directory on the same
# disk, so both share one navidrome.db).
#
# Cheap to re-point, unlike the other services: navidrome stores media_file and
# folder paths RELATIVE to the library root, with the absolute part living only
# in the `library` table. Changing where a library lives is an UPDATE of one
# row — play counts, ratings, favourites and playlists all keep their ids.
#
# Do NOT write ${VAR}:${VAR} here; that would put a host path back into the DB.
Volume=${NAVIDROME_MUSIC}:/music:ro
Volume=${NAVIDROME_OLD_MUSIC}:/old_music:ro

# Sets library id 1's path. Further libraries ("Old music" is id 2) are stored
# in the DB and managed from the web UI, so their paths must be kept in step
# there — this env var does not reach them.
Environment=ND_MUSICFOLDER=/music

Environment=TZ=Europe/Kyiv

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
