[Unit]
Description=Crafty Controller (Minecraft server manager)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=crafty
Image=registry.gitlab.com/crafty-controller/crafty-4:latest
AutoUpdate=registry

PublishPort=8443:8443
PublishPort=8123:8123
PublishPort=19132:19132/udp
PublishPort=25500-25600:25500-25600

# $CRAFTY_DIR is an env var so nothing host-specific is baked into this
# (git-tracked) quadlet — though it is one of the few that happens to be the
# same string on both installs, since /storage/data is mounted at the same
# path.
#
# On NixOS it is generated from nix/hosts/aorus/services.nix — do not edit it
# by hand there. On Arch it lives in an untracked drop-in at
# 	systemd/user/crafty.service.d/override.conf
# in this repo (~/.config/systemd is a symlink to systemd/, and its .gitignore
# keeps the drop-in out of git). Edit it directly, or via
# 	systemctl --user edit crafty.service

# The container paths are the image's own fixed locations, so nothing
# host-specific reaches Crafty's config or the server data.

Volume=${CRAFTY_DIR}/backups:/crafty/backups:Z
Volume=${CRAFTY_DIR}/logs:/crafty/logs:Z
Volume=${CRAFTY_DIR}/servers:/crafty/servers:Z
Volume=${CRAFTY_DIR}/config:/crafty/app/config:Z
Volume=${CRAFTY_DIR}/import:/crafty/import:Z

Environment=TZ=Europe/Kyiv

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
