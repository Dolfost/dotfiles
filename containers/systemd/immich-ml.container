[Unit]
Description=Immich machine learning (faces, smart search)
# Retry forever on a not-yet-mounted $IMMICH_DIR — see immich-server.container.
StartLimitIntervalSec=0

[Container]
ContainerName=immich-ml
Image=ghcr.io/immich-app/immich-machine-learning:release
AutoUpdate=registry
Pod=immich.pod

Volume=${IMMICH_DIR}/model-cache:/cache

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
