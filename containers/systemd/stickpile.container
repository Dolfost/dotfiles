[Unit]
Description=stickpile sticker and meme library
After=network-online.target
Wants=network-online.target
# $STICKPILE_DIR may live on a nofail mount that is not up yet. podman refuses
# to start on a missing bind source (it does not create it, unlike docker), so
# the only cost of being early is a failed start, but the default rate limit
# would then give up after 5 tries in 10s. Retry forever instead, which needs
# no per-host mount dependency.
StartLimitIntervalSec=0

[Container]
ContainerName=stickpile
Image=ghcr.io/dolfost/stickpile:latest
AutoUpdate=registry

# Every host path is an env var so nothing host-specific is baked into this
# (git-tracked) quadlet. Set it in a drop-in:
# 	~/.config/systemd/user/stickpile.service.d/env.conf
# 	[Service]
# 	Environment=STICKPILE_DIR=/storage/2.5/stickpile
# (stickpile.service.d/env.conf.example next to this file; on NixOS it is
# generated by home-manager, see deploy/aorus/stickpile.nix). Or edit it via
# 	systemctl --user edit stickpile.service

# All stickpile state lives under $STICKPILE_DIR. Move that dir + this quadlet
# and the instance moves with it.
# 	stickpile.db      SQLite database (users, sets, items, stats)
# 	media/            content-addressed originals and variants
# 	gitpacks/         clones of git-bound sets
# 	models/           CLIP models, if ai.enabled (docs/deployment.md)
# 	tmp/              upload staging (TMPDIR), same filesystem as media/
# 	tailscale.sock    trusted listener for `tailscale serve`, created at start
# 	config.toml       server configuration, mounted read-only below
# 	secrets/          bot token, admin password, ... mounted read-only below
Volume=${STICKPILE_DIR}:/var/lib/stickpile:Z

# The server only reads its configuration and secrets, so they are mounted
# read-only on top, at fixed container paths that config.toml refers to.
Volume=${STICKPILE_DIR}/config.toml:/etc/stickpile/config.toml:ro,Z
Volume=${STICKPILE_DIR}/secrets:/run/secrets/stickpile:ro,Z
# The Telegram bot token comes from sops (nix/hosts/aorus/services/stickpile.nix
# sets $STICKPILE_TELEGRAM_TOKEN), so it is mounted as a file of its own: the
# /run/secrets entries are links into /run/secrets.d, which would not resolve
# inside the container. No Z: it is sops-nix's file, not ours to relabel.
Volume=${STICKPILE_TELEGRAM_TOKEN}:/run/secrets/telegram-bot-token:ro

# Who owns the files. The image runs as uid/gid 65532 (never root). keep-id
# maps YOUR host uid to 65532 inside the container, so everything under
# $STICKPILE_DIR, the tailscale socket included, is owned by you on the host:
# plain `cp`/`restic` backups, no `podman unshare chown`, and the same owner
# when another OS mounts the disk. Without it 65532 would land on host uid
# 165531 (/etc/subuid), like paperless' 100999.
UserNS=keep-id:uid=65532,gid=65532

# Root filesystem is read-only; every write goes to the volume above. podman
# still mounts a small tmpfs on /tmp and /run (unused by the server).
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

# Plain HTTP for local tools and as a fallback when the tailnet socket below
# is not used. Loopback only: with rootless podman every local user can reach
# it, so tailscale identity headers are NEVER trusted on this port.
PublishPort=127.0.0.1:8080:8080

# The trusted path: the server listens on /var/lib/stickpile/tailscale.sock
# (trusted_proxy.socket in config.toml), i.e. $STICKPILE_DIR/tailscale.sock on
# the host, and trusts Tailscale-User-Login only there. tailscaled (root)
# proxies to it:
# 	tailscale serve --service=svc:stickpile --https=443 unix:$STICKPILE_DIR/tailscale.sock
# Nothing to publish for that; the socket is a file in the volume.

Environment=TZ=Europe/Kyiv

# Liveness through the server binary itself, in exec form (the image has no
# shell, so the plain-string form, which podman runs via /bin/sh -c, would fail):
# GET /healthz on the configured listen address, exit 0/1.
HealthCmd=["CMD","/bin/stickpile-server","healthcheck"]
HealthInterval=1m
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
