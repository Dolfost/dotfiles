[Unit]
Description=Gitea (self-hosted git service)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=gitea
Image=docker.gitea.com/gitea:latest
AutoUpdate=registry

# Web UI and git-over-SSH
PublishPort=3000:3000
PublishPort=2222:22

# On NixOS it is generated from nix/hosts/aorus/services.nix — do not edit it
# by hand there. On Arch it lives in an untracked drop-in at
# 	systemd/user/gitea.service.d/override.conf
# in this repo (~/.config/systemd is a symlink to systemd/, and its .gitignore
# keeps the drop-in out of git). Edit it directly, or via
# 	systemctl --user edit gitea.service
Volume=${GITEA_DIR}:/data:Z

Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=TZ=Europe/Kyiv

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
