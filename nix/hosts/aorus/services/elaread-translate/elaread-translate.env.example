# /etc/elaread-translate.env — chmod 600, owned by root: it holds a token.

# A long-lived Claude token from `claude setup-token` (any machine with a browser).
# Whoever creates it pays for the translations with their own subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# The claude binary, readable by any user (the service runs as its own one).
ELAREAD_CLAUDE=/usr/local/bin/claude

# This host's tailnet address (`tailscale ip -4`) and the relay's port.
ELAREAD_LISTEN=100.91.220.75:8787

# Who may use it, comma-separated: the owner's own tailnet nodes
# (evictus, the phone eparadigm, efog) and the host itself.
ELAREAD_ALLOW=127.0.0.1,100.67.0.1,100.67.0.2,100.67.0.3

# claude processes at once; the app's Fast preset sends up to 4 batches together.
ELAREAD_PARALLEL=4
