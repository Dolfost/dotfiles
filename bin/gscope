#!/usr/bin/env bash
# steam launch wrapper: gamescope + mangohud + gamemode. Usage in Steam launch
# options: gscope %command% Resolution/refresh auto-detected from focused
# Hyprland monitor. Overrides: ~/.config/gscope/default.env (per-host), then
# ~/.config/gscope/<SteamAppId>.env (per-game)

# fallback defaults if Hyprland query fails
WIDTH=2560
HEIGHT=1440
REFRESH=180
OUTPUT=""

# gamescope feature toggles (override in ~/.config/gscope/*.env)
GAMESCOPE=1    # 0: run the game directly under gamemode + mangohud layer.
               # Nested gamescope is broken on NVIDIA hybrids (judder on the
               # iGPU path, gamescope#2081 on the dGPU path) and on a laptop
               # panel it adds nothing over Hyprland fullscreen anyway.
HDR=1
VRR=1
HUD_HIDDEN=1   # 1: start with HUD hidden (toggle with Shift+F12); 0: start visible
VK_DEVICE=""   # vendor:device (e.g. 10de:2d58) to pin gamescope compositing to
               # one GPU; on hybrid laptops it defaults to the iGPU while the
               # game renders on the dGPU, and that cross-GPU import judders
BACKEND=""     # nested backend override; NVIDIA compositing needs "sdl" - the
               # default wayland backend's dmabuf export never maps a window
               # there (ValveSoftware/gamescope#2081)
GRAB=1         # 0: drop --force-grab-cursor (stalls with the sdl backend)

export LD_PRELOAD=""
export AMD_USERQ=1
export PROTON_USE_NTSYNC=1
export MANGOHUD=1   # required for the --mangoapp overlay to hook the game
export VK_LOADER_LAYERS_ENABLE=VK_LAYER_VALVE_steam_overlay_64
# export PROTON_NO_FSYNC=0
# export PROTON_NO_ESYNC=0

if command -v hyprctl >/dev/null && command -v jq >/dev/null \
	&& hyprctl monitors >/dev/null 2>&1; then
read -r WIDTH HEIGHT REFRESH OUTPUT < <(
	hyprctl -j monitors | jq -r '
	((map(select(.focused))) + .) | .[0] |
		"\(.width) \(.height) \(.refreshRate) \(.name)"
	'
)
fi

[[ -r "$HOME/.config/gscope/default.env" ]] && source "$HOME/.config/gscope/default.env"
if [[ -n "$SteamAppId" && -r "$HOME/.config/gscope/$SteamAppId.env" ]]; then
	source "$HOME/.config/gscope/$SteamAppId.env"
fi

REFRESH=$(printf "%.0f" "$REFRESH")

MANGOHUD_CONFIG="read_cfg,fps_limit=$((REFRESH - 3))"
[[ "$HUD_HIDDEN" == 1 ]] && MANGOHUD_CONFIG+=",no_display"
export MANGOHUD_CONFIG

[[ "$GAMESCOPE" == 0 ]] && exec gamemoderun mangohud "$@"

GS_ARGS=(-W "$WIDTH"
	-H "$HEIGHT"
	-r "$REFRESH"
	--fullscreen
	--mangoapp
)
[[ "$GRAB" == 1 ]] && GS_ARGS+=(--force-grab-cursor)

[[ "$HDR" == 1 ]] && GS_ARGS+=(--hdr-enabled)
[[ "$VRR" == 1 ]] && GS_ARGS+=(--adaptive-sync)
[[ -n "$OUTPUT" ]] && GS_ARGS+=(--prefer-output "$OUTPUT")
[[ -n "$VK_DEVICE" ]] && GS_ARGS+=(--prefer-vk-device "$VK_DEVICE")
[[ -n "$BACKEND" ]] && GS_ARGS+=(--backend "$BACKEND")

exec gamemoderun gamescope "${GS_ARGS[@]}" -- "$@"
