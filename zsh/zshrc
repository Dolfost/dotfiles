export ZSH_CONFIG="$HOME/.config/zsh"

source $ZSH_CONFIG/exports.zsh
source $ZSH_CONFIG/aliases.zsh
source $ZSH_CONFIG/visuals.zsh
source $ZSH_CONFIG/binds.zsh
source $ZSH_CONFIG/options.zsh
if [ -f "$ZSH_CONFIG/secrets.zsh" ]; then
	source $ZSH_CONFIG/secrets.zsh
fi

if command -v direnv 1>/dev/null 2>&1; then
	eval "$(direnv hook zsh)"
fi

eval "$(sheldon source)"
# herdr panes already are a multiplexer - don't nest zellij inside them.
# zj (bin/zj) starts the session's server in its own systemd unit so it
# outlives the compositor; bare `zellij` forks it inside the terminal's scope.
if [[ -z "$ZELLIJ" && -z "$HERDR_PANE_ID" ]]; then
	zj
fi
