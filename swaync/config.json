{
  "positionX": "right",
  "positionY": "top",

  "control-center-width": 460,
  "control-center-height": 700,
  "control-center-margin-top": 5,
  "control-center-margin-right": 5,
  "control-center-margin-bottom": 5,
  "fit-to-screen": true,

  "notification-window-width": 420,
  "notification-icon-size": 32,
  "notification-body-image-height": 130,
  "notification-body-image-width": 300,

  "timeout": 20,
  "timeout-low": 3,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "image-visibility": "when-available",
  "transition-time": 50,

  "scripts": {
    "notification-click-focus": {
      "exec": "/home/vladyslav/.config/hypr/hypr/scripts/notification_focus.sh",
      "run-on": "action"
    }
  },

  "widgets": ["title", "dnd", "notifications"],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    }
  }
}
